{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "MSVC x64 Release (Ninja)",
      "description": "Single-config Release build; CommonLib from source, static vcpkg libs.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "COMMONLIB_PREBUILT": "OFF"
      }
    },
    {
      "name": "release-vs",
      "displayName": "Visual Studio 2022 x64 Release",
      "description": "Same, with the Visual Studio generator (for opening in the IDE).",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "COMMONLIB_PREBUILT": "OFF",
        "COMMONLIB_PREBUILT_MULTICONFIG": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "release-vs", "configurePreset": "release-vs", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
